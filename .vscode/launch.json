{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Album Print Flow (module)",
      "type": "debugpy",
      "request": "launch",
      "module": "album_print_flow",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Album Print Flow (file)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/album_print_flow/main.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ]
}
